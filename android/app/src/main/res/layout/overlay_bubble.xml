<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ov_head"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/ov_head_ring"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/overlay_bubble_bg"
        android:elevation="8dp"/>

    <ImageView
        android:id="@+id/ov_head_icon"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="center"
        android:layout_marginBottom="3dp"
        android:src="@mipmap/ic_launcher_round"
        android:contentDescription="@string/app_name"
        android:elevation="9dp"/>

    <TextView
        android:id="@+id/ov_head_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:paddingBottom="5dp"
        android:text="—"
        android:textColor="#FFF8E8"
        android:textSize="8sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2.5"
        android:elevation="10dp"/>

    <View
        android:id="@+id/ov_head_dot"
        android:layout_width="11dp"
        android:layout_height="11dp"
        android:layout_gravity="top|end"
        android:layout_margin="1dp"
        android:background="@drawable/overlay_signal_dot"
        android:elevation="11dp"/>
</FrameLayout>
